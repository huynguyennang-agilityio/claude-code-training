# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (used by docker-compose and the backend)
POSTGRES_USER=stridequest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stridequest
# Change if 5432 is already used on your machine, and update DATABASE_URL and
# TEST_DATABASE_URL to match.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://stridequest:change-me@localhost:5432/stridequest
# Integration tests use their own database on the same server. The name must be
# letters, digits and underscores ending in "_test": each test run wipes its public
# schema and rebuilds it with the migrations. It is created if it doesn't exist.
TEST_DATABASE_URL=postgresql+asyncpg://stridequest:change-me@localhost:5432/stridequest_test

# S3-compatible object storage for medal images (SeaweedFS locally, S3 in production)
S3_ACCESS_KEY=stridequest
S3_SECRET_KEY=change-me-too
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=medals

# Authentication
JWT_SECRET=replace-with-a-long-random-string

# Optional: token lifetimes (defaults shown)
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
